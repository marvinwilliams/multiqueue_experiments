{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 16
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "environment": {
        "WARNINGS": "-Wall -Wextra -Wpedantic -Wconversion -Wsign-conversion -Wshadow -Wduplicated-branches -Wduplicated-cond -Wlogical-op -Wnull-dereference -Wuseless-cast -Wdouble-promotion -Wold-style-cast -Wformat=2 -Wundef -Wcast-align -Wcast-qual -Wdisabled-optimization -Wredundant-decls -Wunsafe-loop-optimizations -Wsuggest-final-types -Wsuggest-final-methods -Wsuggest-override"
      }
    },
    {
      "name": "devel",
      "displayName": "Development Preset",
      "inherits": "base",
      "binaryDir": "build/devel",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Devel",
        "CMAKE_CXX_FLAGS_DEVEL": "$env{WARNINGS} -O2 -g -fno-omit-frame-pointer -march=native"
      },
      "warnings": {
        "dev": true,
        "uninitialized": true
      }
    },
    {
      "name": "release",
      "displayName": "Release Preset",
      "inherits": "base",
      "binaryDir": "build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON",
        "CMAKE_CXX_FLAGS_RELEASE": "$env{WARNINGS} -O3 -DNDEBUG -march=native"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug Preset",
      "inherits": "base",
      "binaryDir": "build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS_DEBUG": "$env{WARNINGS} -Og -g -march=native"
      }
    },
    {
      "name": "asan",
      "displayName": "ASan Preset",
      "inherits": "base",
      "binaryDir": "build/asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "ASan",
        "CMAKE_CXX_FLAGS_ASAN": "$env{WARNINGS} -O2 -g -fno-omit-frame-pointer -march=native -fsanitize=address"
      }
    },
    {
      "name": "ubsan",
      "displayName": "UBSan Preset",
      "inherits": "base",
      "binaryDir": "build/ubsan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "UBSan",
        "CMAKE_CXX_FLAGS_UBSAN": "$env{WARNINGS} -O2 -g -fno-omit-frame-pointer -march=native -fsanitize=undefined"
      }
    },
    {
      "name": "tsan",
      "displayName": "TSan Preset",
      "inherits": "base",
      "binaryDir": "build/tsan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "TSan",
        "CMAKE_CXX_FLAGS": "$env{WARNINGS} -O2 -g -fno-omit-frame-pointer -march=native -fsanitize=thread"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "devel",
      "displayName": "Devel Preset",
      "configurePreset": "devel"
    },
    {
      "name": "release",
      "displayName": "Release Preset",
      "configurePreset": "release"
    },
    {
      "name": "debug",
      "displayName": "Debug preset",
      "configurePreset": "debug"
    },
    {
      "name": "asan",
      "displayName": "ASan Preset",
      "configurePreset": "asan"
    },
    {
      "name": "ubsan",
      "displayName": "UBSan Preset",
      "configurePreset": "ubsan"
    },
    {
      "name": "tsan",
      "displayName": "TSan Preset",
      "configurePreset": "tsan"
    }
  ]
}
